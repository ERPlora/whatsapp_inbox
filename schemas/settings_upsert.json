{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "whatsapp_inbox.settings.upsert",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "is_enabled", "account_mode", "auto_reply_enabled", "approval_mode",
    "require_confirmation", "request_schema", "gpt_system_prompt",
    "input_modules", "output_modules", "auto_close_hours",
    "notify_staff_new_request", "greeting_message", "out_of_hours_message"
  ],
  "properties": {
    "is_enabled": { "type": "integer", "enum": [0, 1] },
    "account_mode": { "type": "string", "enum": ["shared", "per_employee"] },
    "auto_reply_enabled": { "type": "integer", "enum": [0, 1] },
    "approval_mode": { "type": "string", "enum": ["auto", "manual"] },
    "require_confirmation": { "type": "integer", "enum": [0, 1] },
    "request_schema": { "type": "string", "description": "JSON: esquema dinámico de requests" },
    "gpt_system_prompt": { "type": "string" },
    "input_modules": { "type": "string", "description": "JSON array de module_id" },
    "output_modules": { "type": "string", "description": "JSON array de module_id" },
    "auto_close_hours": { "type": "integer", "minimum": 0 },
    "notify_staff_new_request": { "type": "integer", "enum": [0, 1] },
    "greeting_message": { "type": "string" },
    "out_of_hours_message": { "type": "string" },
    "free_tier_monthly_limit": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "deprecated": true,
      "description": "DEPRECATED and IGNORED since whatsapp_inbox#37: this is the channel's billing meter, not a preference. Its single writer is whatsapp_inbox._quota.set (internal), fed by the Cloud, where the plan's allowance is decided. Still accepted so an older screen that echoes the value back does not start failing — the command's SQL no longer reads it. Read the current value with whatsapp_inbox.usage.get."
    }
  }
}
