{
  "id": "whatsapp_inbox",
  "name": "WhatsApp Inbox",
  "version": "2.1.25",
  "description": "WhatsApp conversations, inbound requests, message templates and channel settings.",
  "agent": {
    "description": "Manages WhatsApp conversations, inbound requests, message templates, and channel settings: list and read conversations/messages, assign conversations, approve or reject requests, and configure the WhatsApp channel.",
    "keywords": [
      "whatsapp",
      "inbox",
      "conversation",
      "message",
      "request",
      "template",
      "channel",
      "messaging"
    ]
  },
  "depends_on": [
    "customers"
  ],
  "permissions": [
    "whatsapp_inbox.view_conversation",
    "whatsapp_inbox.view_request",
    "whatsapp_inbox.change_request",
    "whatsapp_inbox.delete_request",
    "whatsapp_inbox.manage_settings",
    "whatsapp_inbox.manage_connections"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "whatsapp_inbox.change_request",
      "whatsapp_inbox.view_conversation",
      "whatsapp_inbox.view_request"
    ],
    "employee": [
      "whatsapp_inbox.view_conversation",
      "whatsapp_inbox.view_request"
    ]
  },
  "navigation": [
    {
      "id": "inbox",
      "label": "Inbox",
      "icon": "chatbubbles-outline",
      "component": "erp-whatsapp-inbox-inbox"
    },
    {
      "id": "requests",
      "label": "Requests",
      "icon": "clipboard-outline",
      "component": "erp-whatsapp-inbox-requests"
    },
    {
      "id": "templates",
      "label": "Templates",
      "icon": "document-text-outline",
      "component": "erp-whatsapp-inbox-templates"
    },
    {
      "id": "settings",
      "label": "Settings",
      "icon": "settings-outline",
      "component": "erp-whatsapp-inbox-settings"
    }
  ],
  "migrations": {
    "postgres": [
      "migrations/postgres/001_init.sql",
      "migrations/postgres/002_free_tier.sql",
      "migrations/postgres/003_request_counter.sql",
      "migrations/postgres/004_booking_handoff.sql",
      "migrations/postgres/005_message_dedup.sql"
    ]
  },
  "queries": {
    "whatsapp_inbox.conversations.list": {
      "permission": "whatsapp_inbox.view_conversation",
      "sql": "queries/conversations_list.sql",
      "list": {
        "search": [
          "customer_id",
          "phone_number_id",
          "contact_name",
          "contact_phone"
        ],
        "sort": [
          "id",
          "customer_id",
          "assigned_to_id",
          "phone_number_id",
          "wa_contact_id",
          "contact_name",
          "contact_phone",
          "status",
          "last_message_at",
          "unread_count"
        ],
        "default_sort": "id",
        "default_dir": "asc",
        "filters": {
          "customer_id": {
            "op": "eq"
          },
          "assigned_to_id": {
            "op": "eq"
          },
          "phone_number_id": {
            "op": "eq"
          },
          "wa_contact_id": {
            "op": "eq"
          },
          "contact_name": {
            "op": "eq"
          },
          "contact_phone": {
            "op": "like"
          },
          "status": {
            "op": "eq"
          },
          "last_message_at": {
            "op": "range"
          },
          "unread_count": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists all WhatsApp conversations in the inbox"
      }
    },
    "whatsapp_inbox.conversations.get": {
      "permission": "whatsapp_inbox.view_conversation",
      "sql": "queries/conversation_get.sql",
      "schema": "schemas/conversation_get.json",
      "ai": {
        "description": "Retrieves the details of a WhatsApp conversation by its ID"
      }
    },
    "whatsapp_inbox.messages.list": {
      "permission": "whatsapp_inbox.view_conversation",
      "sql": "queries/messages_list.sql",
      "list": {
        "sort": [
          "id",
          "conversation_id",
          "direction",
          "wa_message_id",
          "message_type",
          "body",
          "media_url",
          "status",
          "created_at"
        ],
        "default_sort": "created_at",
        "default_dir": "desc",
        "filters": {
          "conversation_id": {
            "op": "eq"
          },
          "direction": {
            "op": "eq"
          },
          "wa_message_id": {
            "op": "eq"
          },
          "message_type": {
            "op": "eq"
          },
          "body": {
            "op": "like"
          },
          "media_url": {
            "op": "eq"
          },
          "status": {
            "op": "eq"
          },
          "created_at": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the messages within a WhatsApp conversation"
      }
    },
    "whatsapp_inbox.requests.list": {
      "permission": "whatsapp_inbox.view_request",
      "sql": "queries/requests_list.sql",
      "list": {
        "search": [
          "reference_number",
          "contact_name"
        ],
        "sort": [
          "id",
          "conversation_id",
          "reference_number",
          "request_type",
          "status",
          "raw_summary",
          "confidence_score",
          "linked_module",
          "created_at",
          "contact_name"
        ],
        "default_sort": "created_at",
        "default_dir": "desc",
        "filters": {
          "conversation_id": {
            "op": "eq"
          },
          "reference_number": {
            "op": "eq"
          },
          "request_type": {
            "op": "eq"
          },
          "status": {
            "op": "eq"
          },
          "raw_summary": {
            "op": "eq"
          },
          "confidence_score": {
            "op": "range"
          },
          "linked_module": {
            "op": "eq"
          },
          "created_at": {
            "op": "range"
          },
          "contact_name": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists inbound requests received through the WhatsApp channel"
      }
    },
    "whatsapp_inbox.requests.get": {
      "permission": "whatsapp_inbox.view_request",
      "sql": "queries/request_get.sql",
      "schema": "schemas/request_get.json",
      "ai": {
        "description": "Retrieves the details of a WhatsApp request by its ID"
      }
    },
    "whatsapp_inbox.templates.list": {
      "permission": "whatsapp_inbox.manage_settings",
      "sql": "queries/templates_list.sql",
      "list": {
        "search": [
          "name"
        ],
        "sort": [
          "id",
          "name",
          "language",
          "category",
          "header",
          "body",
          "footer",
          "meta_template_id",
          "meta_status",
          "variables",
          "is_active",
          "created_at",
          "updated_at"
        ],
        "default_sort": "created_at",
        "default_dir": "desc",
        "filters": {
          "name": {
            "op": "like"
          },
          "language": {
            "op": "eq"
          },
          "category": {
            "op": "eq"
          },
          "header": {
            "op": "eq"
          },
          "body": {
            "op": "like"
          },
          "footer": {
            "op": "eq"
          },
          "meta_template_id": {
            "op": "eq"
          },
          "meta_status": {
            "op": "eq"
          },
          "variables": {
            "op": "eq"
          },
          "is_active": {
            "op": "eq"
          },
          "created_at": {
            "op": "range"
          },
          "updated_at": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the available WhatsApp message templates"
      }
    },
    "whatsapp_inbox.settings.get": {
      "permission": "whatsapp_inbox.manage_settings",
      "sql": "queries/settings_get.sql",
      "ai": {
        "description": "Retrieves the current WhatsApp channel configuration"
      }
    },
    "whatsapp_inbox.usage.get": {
      "permission": "whatsapp_inbox.manage_settings",
      "sql": "queries/usage_get.sql",
      "ai": {
        "description": "Inbound WhatsApp messages consumed this calendar month and the monthly allowance of the plan (0 = no cap). Read-only: the allowance is set by billing, never from the hub."
      }
    }
  },
  "commands": {
    "whatsapp_inbox.conversations.assign": {
      "permission": "whatsapp_inbox.manage_settings",
      "transaction": true,
      "sql": [
        "commands/conversation_assign.sql"
      ],
      "schema": "schemas/conversation_assign.json",
      "emit": [
        "whatsapp_inbox.conversation.assigned"
      ],
      "ai": {
        "description": "Assigns a WhatsApp conversation to an agent or team"
      }
    },
    "whatsapp_inbox.requests.approve": {
      "permission": "whatsapp_inbox.change_request",
      "transaction": true,
      "sql": [
        "commands/request_approve.sql"
      ],
      "schema": "schemas/request_approve.json",
      "emit": [
        "whatsapp_inbox.request.approved"
      ],
      "ai": {
        "description": "Approves an inbound WhatsApp request"
      }
    },
    "whatsapp_inbox.requests.reject": {
      "permission": "whatsapp_inbox.change_request",
      "transaction": true,
      "sql": [
        "commands/request_reject.sql"
      ],
      "schema": "schemas/request_reject.json",
      "emit": [
        "whatsapp_inbox.request.rejected"
      ],
      "ai": {
        "description": "Rejects an inbound WhatsApp request"
      }
    },
    "whatsapp_inbox.requests.delete": {
      "permission": "whatsapp_inbox.delete_request",
      "transaction": true,
      "sql": [
        "commands/request_delete.sql"
      ],
      "schema": "schemas/request_delete.json",
      "emit": [
        "whatsapp_inbox.request.deleted"
      ],
      "ai": {
        "description": "Soft-deletes a WhatsApp request; already-fulfilled requests cannot be deleted"
      }
    },
    "whatsapp_inbox.requests.fulfill": {
      "permission": "whatsapp_inbox.change_request",
      "schema": "schemas/request_fulfill.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "fulfill_request"
      },
      "emit": [
        "whatsapp_inbox.request.fulfilled"
      ],
      "ai": {
        "description": "Marks a CONFIRMED WhatsApp request as fulfilled — a note that a person handled it. It creates nothing in another module and never has: cross-module dispatch from a handler is forbidden by design (hub#659, ADR-0283 §7), so `create_linked_object: true` returns `cross_module_dispatch_unsupported` and changes nothing. To materialise a request, use a flow with an explicit grant, or the booking panel of the Requests screen for an appointment."
      }
    },
    "whatsapp_inbox._fulfill_transition": {
      "permission": "whatsapp_inbox.change_request",
      "sql": [
        "commands/_fulfill_transition.sql"
      ]
    },
    "whatsapp_inbox._link_fulfilled": {
      "permission": "whatsapp_inbox.change_request",
      "internal": true,
      "transaction": true,
      "sql": [
        "commands/_link_fulfilled.sql"
      ],
      "schema": "schemas/link_fulfilled.json"
    },
    "whatsapp_inbox._booking_failed": {
      "permission": "whatsapp_inbox.change_request",
      "internal": true,
      "transaction": true,
      "sql": [
        "commands/_booking_failed.sql"
      ],
      "schema": "schemas/booking_failed.json"
    },
    "whatsapp_inbox.requests.ingest": {
      "permission": "whatsapp_inbox.manage_connections",
      "schema": "schemas/request_ingest.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "parse_inbound_message"
      },
      "emit": [
        "whatsapp_inbox.request.created"
      ],
      "ai": {
        "description": "Creates the AI-parsed request from an inbound message already ingested by messages.ingest: validates parsed_data against the dynamic request_schema, maps confidence to confidence_score, generates the atomic WA-YYYYMMDD-NNNN reference number, and sets status from approval_mode (auto=confirmed, manual=pending_review)."
      }
    },
    "whatsapp_inbox._bump_request_counter": {
      "permission": "whatsapp_inbox.manage_connections",
      "sql": [
        "commands/_bump_request_counter.sql"
      ]
    },
    "whatsapp_inbox._insert_request": {
      "permission": "whatsapp_inbox.manage_connections",
      "sql": [
        "commands/_insert_request.sql"
      ]
    },
    "whatsapp_inbox.templates.create": {
      "permission": "whatsapp_inbox.manage_settings",
      "transaction": true,
      "sql": [
        "commands/template_create.sql"
      ],
      "schema": "schemas/template_create.json",
      "emit": [
        "whatsapp_inbox.template.created"
      ],
      "ai": {
        "description": "Creates a new WhatsApp message template"
      }
    },
    "whatsapp_inbox.templates.update": {
      "permission": "whatsapp_inbox.manage_settings",
      "transaction": true,
      "sql": [
        "commands/template_update.sql"
      ],
      "schema": "schemas/template_update.json",
      "emit": [
        "whatsapp_inbox.template.updated"
      ],
      "ai": {
        "description": "Updates the content of an existing WhatsApp message template"
      }
    },
    "whatsapp_inbox.templates.delete": {
      "permission": "whatsapp_inbox.manage_settings",
      "transaction": true,
      "sql": [
        "commands/template_delete.sql"
      ],
      "schema": "schemas/template_delete.json",
      "emit": [
        "whatsapp_inbox.template.deleted"
      ],
      "ai": {
        "description": "Soft-deletes a WhatsApp message template"
      }
    },
    "whatsapp_inbox.messages.ingest": {
      "permission": "whatsapp_inbox.manage_connections",
      "transaction": true,
      "sql": [
        "commands/message_ingest_conv.sql",
        "commands/message_ingest_msg.sql",
        "commands/message_ingest_stats.sql"
      ],
      "schema": "schemas/message_ingest.json",
      "emit": [
        "whatsapp_inbox.message.received"
      ],
      "ai": {
        "description": "Ingests an inbound WhatsApp message: upserts the conversation, persists the message, and emits whatsapp_inbox.message.received for other modules (e.g. communications inbox) to react. Enforces the free-tier monthly message limit when configured."
      }
    },
    "whatsapp_inbox._ingest_inbound_message": {
      "permission": "whatsapp_inbox.manage_connections",
      "internal": true,
      "transaction": true,
      "sql": [
        "commands/inbound_conversation_upsert.sql",
        "commands/inbound_message_insert.sql",
        "commands/inbound_conversation_stats.sql"
      ],
      "schema": "schemas/ingest_inbound_message.json",
      "emit": [
        "whatsapp_inbox.message.received"
      ]
    },
    "whatsapp_inbox.settings.upsert": {
      "permission": "whatsapp_inbox.manage_settings",
      "transaction": true,
      "sql": [
        "commands/settings_upsert.sql"
      ],
      "schema": "schemas/settings_upsert.json",
      "emit": [
        "whatsapp_inbox.settings.updated"
      ],
      "ai": {
        "description": "Creates or updates the WhatsApp channel configuration"
      }
    },
    "whatsapp_inbox._quota.set": {
      "permission": "whatsapp_inbox.manage_connections",
      "internal": true,
      "transaction": true,
      "sql": [
        "commands/quota_set.sql"
      ],
      "schema": "schemas/quota_set.json"
    }
  },
  "events": {
    "listen": {
      "hub.whatsapp.message_received": {
        "command": "whatsapp_inbox._ingest_inbound_message"
      },
      "appointments.booking_request.fulfilled": {
        "command": "whatsapp_inbox._link_fulfilled"
      },
      "appointments.booking_request.failed": {
        "command": "whatsapp_inbox._booking_failed"
      }
    },
    "emits": [
      "whatsapp_inbox.message.received",
      "whatsapp_inbox.request.created",
      "whatsapp_inbox.conversation.assigned",
      "whatsapp_inbox.request.approved",
      "whatsapp_inbox.request.rejected",
      "whatsapp_inbox.request.fulfilled",
      "whatsapp_inbox.request.deleted",
      "whatsapp_inbox.template.created",
      "whatsapp_inbox.template.updated",
      "whatsapp_inbox.template.deleted",
      "whatsapp_inbox.settings.updated"
    ]
  },
  "ui": {
    "entry": "dist/whatsapp_inbox.esm.js"
  },
  "billing": {
    "tier": "premium",
    "type": "subscription",
    "trial_days": 15,
    "tiers": [
      {
        "slug": "free",
        "name": "WhatsApp Free",
        "price": 0,
        "interval": "month",
        "quota": {
          "conversations_per_month": 30
        }
      },
      {
        "slug": "starter",
        "name": "WhatsApp Starter",
        "price": 14.99,
        "interval": "month",
        "quota": {
          "conversations_per_month": 200
        }
      },
      {
        "slug": "business",
        "name": "WhatsApp Business",
        "price": 59.99,
        "interval": "month",
        "quota": {
          "conversations_per_month": 800
        }
      },
      {
        "slug": "flex",
        "name": "WhatsApp Flex",
        "price": 19.99,
        "interval": "month",
        "metered": true,
        "overage_price": 0.075,
        "quota": {
          "conversations_per_month": 270
        }
      }
    ]
  }
}
