{
  "id": "whatsapp_inbox",
  "name": "WhatsApp Inbox",
  "version": "2.1.94",
  "description": "WhatsApp conversations, message templates and channel settings.",
  "agent": {
    "description": "Manages WhatsApp conversations, message templates, and channel settings: list and read conversations/messages, assign conversations, and configure the WhatsApp channel.",
    "keywords": [
      "whatsapp",
      "inbox",
      "conversation",
      "message",
      "template",
      "channel",
      "messaging"
    ]
  },
  "depends_on": [
    {
      "id": "customers",
      "min_version": "2.3.47"
    }
  ],
  "compatibility": {
    "min_erplora_version": "1.1.30"
  },
  "permissions": [
    "whatsapp_inbox.view_conversation",
    "whatsapp_inbox.manage_settings",
    "whatsapp_inbox.manage_connections"
  ],
  "capabilities": {
    "notify": {
      "channels": [
        "whatsapp"
      ]
    }
  },
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "whatsapp_inbox.view_conversation"
    ],
    "employee": [
      "whatsapp_inbox.view_conversation"
    ]
  },
  "navigation": [
    {
      "id": "inbox",
      "label": "Inbox",
      "icon": "chatbubbles-outline",
      "component": "erp-whatsapp-inbox-inbox",
      "permission": "whatsapp_inbox.view_conversation"
    },
    {
      "id": "settings",
      "label": "Settings",
      "icon": "settings-outline",
      "component": "erp-whatsapp-inbox-settings",
      "permission": "whatsapp_inbox.manage_settings"
    }
  ],
  "migrations": {
    "postgres": [
      "migrations/postgres/001_init.sql",
      "migrations/postgres/002_free_tier.sql",
      "migrations/postgres/003_request_counter.sql",
      "migrations/postgres/004_booking_handoff.sql",
      "migrations/postgres/005_message_dedup.sql",
      "migrations/postgres/006_message_source.sql",
      "migrations/postgres/007_meta_rejected_reason.sql",
      "migrations/postgres/008_quota_usage.sql",
      "migrations/postgres/009_last_offer.sql",
      "migrations/postgres/010_link_sweep.sql",
      "migrations/postgres/011_template_rich_parts.sql",
      {
        "file": "migrations/postgres/012_retire_dead_settings.sql",
        "kind": "contract",
        "since": "2.1.75"
      },
      {
        "file": "migrations/postgres/013_retire_requests_pipeline.sql",
        "kind": "contract",
        "since": "2.1.83"
      },
      "migrations/postgres/014_template_header_example.sql"
    ]
  },
  "queries": {
    "whatsapp_inbox.conversations.list": {
      "permission": "whatsapp_inbox.view_conversation",
      "sql": "queries/conversations_list.sql",
      "list": {
        "search": [
          "customer_id",
          "phone_number_id",
          "contact_name",
          "contact_phone"
        ],
        "sort": [
          "id",
          "customer_id",
          "assigned_to_id",
          "phone_number_id",
          "wa_contact_id",
          "contact_name",
          "contact_phone",
          "status",
          "last_message_at",
          "unread_count"
        ],
        "default_sort": "last_message_at",
        "default_dir": "desc",
        "filters": {
          "customer_id": {
            "op": "eq"
          },
          "assigned_to_id": {
            "op": "eq"
          },
          "phone_number_id": {
            "op": "eq"
          },
          "wa_contact_id": {
            "op": "eq"
          },
          "contact_name": {
            "op": "eq"
          },
          "contact_phone": {
            "op": "like"
          },
          "status": {
            "op": "eq"
          },
          "last_message_at": {
            "op": "range"
          },
          "unread_count": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists all WhatsApp conversations in the inbox"
      }
    },
    "whatsapp_inbox.conversations.get": {
      "permission": "whatsapp_inbox.view_conversation",
      "sql": "queries/conversation_get.sql",
      "schema": "schemas/conversation_get.json",
      "ai": {
        "description": "Retrieves the details of a WhatsApp conversation by its ID"
      }
    },
    "whatsapp_inbox.conversations.last_offer": {
      "permission": "whatsapp_inbox.view_conversation",
      "sql": "queries/conversation_last_offer.sql",
      "ai": {
        "description": "Returns the list of slots offered to a WhatsApp customer in the last 24 hours, if any. Identified by the WhatsApp contact the messages come from"
      }
    },
    "whatsapp_inbox.messages.list": {
      "permission": "whatsapp_inbox.view_conversation",
      "sql": "queries/messages_list.sql",
      "list": {
        "sort": [
          "id",
          "conversation_id",
          "direction",
          "wa_message_id",
          "message_type",
          "body",
          "media_url",
          "status",
          "created_at"
        ],
        "default_sort": "created_at",
        "default_dir": "desc",
        "filters": {
          "direction": {
            "op": "eq"
          },
          "wa_message_id": {
            "op": "eq"
          },
          "message_type": {
            "op": "eq"
          },
          "body": {
            "op": "like"
          },
          "media_url": {
            "op": "eq"
          },
          "status": {
            "op": "eq"
          },
          "created_at": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the messages within a WhatsApp conversation"
      }
    },
    "whatsapp_inbox.templates.list": {
      "permission": "whatsapp_inbox.manage_settings",
      "sql": "queries/templates_list.sql",
      "list": {
        "search": [
          "name"
        ],
        "sort": [
          "id",
          "name",
          "language",
          "category",
          "header",
          "body",
          "footer",
          "meta_template_id",
          "meta_status",
          "variables",
          "is_active",
          "created_at",
          "updated_at"
        ],
        "default_sort": "created_at",
        "default_dir": "desc",
        "filters": {
          "name": {
            "op": "like"
          },
          "language": {
            "op": "eq"
          },
          "category": {
            "op": "eq"
          },
          "header": {
            "op": "eq"
          },
          "body": {
            "op": "like"
          },
          "footer": {
            "op": "eq"
          },
          "meta_template_id": {
            "op": "eq"
          },
          "meta_status": {
            "op": "eq"
          },
          "variables": {
            "op": "eq"
          },
          "is_active": {
            "op": "eq"
          },
          "created_at": {
            "op": "range"
          },
          "updated_at": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the available WhatsApp message templates"
      }
    },
    "whatsapp_inbox.usage.get": {
      "permission": "whatsapp_inbox.manage_settings",
      "sql": "queries/usage_get.sql",
      "ai": {
        "description": "Inbound WhatsApp messages consumed this calendar month and the monthly allowance of the plan (0 = no cap). Read-only: the allowance is set by billing, never from the hub."
      }
    },
    "whatsapp_inbox.conversations.unlinked": {
      "permission": "whatsapp_inbox.manage_connections",
      "sql": "queries/conversations_unlinked.sql",
      "schema": "schemas/conversations_unlinked.json"
    }
  },
  "commands": {
    "whatsapp_inbox.conversations.assign": {
      "permission": "whatsapp_inbox.manage_settings",
      "transaction": true,
      "sql": [
        "commands/conversation_assign.sql"
      ],
      "schema": "schemas/conversation_assign.json",
      "emit": [
        "whatsapp_inbox.conversation.assigned"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "whatsapp_inbox.conversation_not_found",
        "message": "That conversation does not exist in this business."
      },
      "ai": {
        "description": "Assigns a WhatsApp conversation to an agent or team"
      }
    },
    "whatsapp_inbox.conversations.link_customer": {
      "permission": "whatsapp_inbox.manage_settings",
      "transaction": true,
      "sql": [
        "commands/conversation_link_customer.sql"
      ],
      "schema": "schemas/conversation_link_customer.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "whatsapp_inbox.conversation_not_found",
        "message": "That conversation does not exist in this business."
      },
      "ai": {
        "description": "Remembers which customer a WhatsApp conversation belongs to, so the inbox can be filtered by her. Identified by the WhatsApp contact the messages come from"
      }
    },
    "whatsapp_inbox.conversations.remember_offer": {
      "permission": "whatsapp_inbox.manage_settings",
      "transaction": true,
      "sql": [
        "commands/conversation_remember_offer.sql"
      ],
      "schema": "schemas/conversation_remember_offer.json",
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "whatsapp_inbox.conversation_not_found",
        "message": "That conversation does not exist in this business."
      },
      "ai": {
        "description": "Remembers the list of slots an automation just offered a WhatsApp customer, so her next message (\"the 2nd\", \"12:30\") can be resolved against it. An empty list clears it. Identified by the WhatsApp contact the messages come from"
      }
    },
    "whatsapp_inbox.templates.create": {
      "permission": "whatsapp_inbox.manage_settings",
      "transaction": true,
      "sql": [
        "commands/template_create.sql"
      ],
      "schema": "schemas/template_create.json",
      "emit": [
        "whatsapp_inbox.template.created"
      ],
      "ai": {
        "description": "Creates a new WhatsApp message template"
      }
    },
    "whatsapp_inbox.templates.update": {
      "permission": "whatsapp_inbox.manage_settings",
      "transaction": true,
      "sql": [
        "commands/template_update.sql"
      ],
      "schema": "schemas/template_update.json",
      "emit": [
        "whatsapp_inbox.template.updated"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "whatsapp_inbox.template_not_found",
        "message": "That template does not exist in this business."
      },
      "ai": {
        "description": "Updates the content of an existing WhatsApp message template"
      }
    },
    "whatsapp_inbox.templates.record_meta_answer": {
      "permission": "whatsapp_inbox.manage_settings",
      "transaction": true,
      "sql": [
        "commands/template_record_meta_answer.sql"
      ],
      "schema": "schemas/template_record_meta_answer.json",
      "ai": {
        "description": "Records what Meta answered about a template (its id, verdict and refusal reason). Called by the screen right after registering the template with Meta, never on its own"
      }
    },
    "whatsapp_inbox.templates.import_from_meta": {
      "permission": "whatsapp_inbox.manage_settings",
      "transaction": true,
      "sql": [
        "commands/template_import_from_meta.sql"
      ],
      "schema": "schemas/template_import_from_meta.json",
      "emit": [
        "whatsapp_inbox.template.created"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "whatsapp_inbox.template_already_here",
        "message": "This business already holds a template with that name and language (live or deleted here), so nothing was brought in."
      }
    },
    "whatsapp_inbox.templates.delete": {
      "permission": "whatsapp_inbox.manage_settings",
      "transaction": true,
      "sql": [
        "commands/template_delete.sql"
      ],
      "schema": "schemas/template_delete.json",
      "emit": [
        "whatsapp_inbox.template.deleted"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "whatsapp_inbox.template_not_found",
        "message": "That template does not exist in this business."
      },
      "ai": {
        "description": "Soft-deletes a WhatsApp message template"
      }
    },
    "whatsapp_inbox.messages.ingest": {
      "permission": "whatsapp_inbox.manage_connections",
      "transaction": true,
      "sql": [
        "commands/message_ingest_conv.sql",
        "commands/message_ingest_msg.sql",
        "commands/message_ingest_stats.sql"
      ],
      "schema": "schemas/message_ingest.json",
      "emit": [
        "whatsapp_inbox.message.received"
      ],
      "ai": {
        "description": "Ingests an inbound WhatsApp message: upserts the conversation, persists the message, and emits whatsapp_inbox.message.received for other modules (e.g. communications inbox) to react. Enforces the free-tier monthly message limit when configured."
      }
    },
    "whatsapp_inbox._ingest_inbound_message": {
      "permission": "whatsapp_inbox.manage_connections",
      "internal": true,
      "transaction": true,
      "sql": [
        "commands/inbound_conversation_upsert.sql",
        "commands/inbound_message_insert.sql",
        "commands/inbound_conversation_stats.sql"
      ],
      "schema": "schemas/ingest_inbound_message.json",
      "emit": [
        "whatsapp_inbox.message.received"
      ]
    },
    "whatsapp_inbox._link_known_customer": {
      "permission": "whatsapp_inbox.manage_connections",
      "internal": true,
      "schema": "schemas/link_known_customer.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "link_known_customer"
      },
      "reads": [
        {
          "query": "customers.by_phone",
          "params": {
            "phone": "payload.contact"
          }
        }
      ]
    },
    "whatsapp_inbox._link_customer_threads": {
      "permission": "whatsapp_inbox.manage_connections",
      "internal": true,
      "schema": "schemas/link_customer_threads.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "link_customer_threads"
      },
      "reads": [
        {
          "query": "customers.by_phone",
          "params": {
            "phone": "payload.phone"
          }
        }
      ]
    },
    "whatsapp_inbox._link_customer_threads_write": {
      "permission": "whatsapp_inbox.manage_connections",
      "internal": true,
      "transaction": true,
      "sql": [
        "commands/_link_customer_threads_write.sql"
      ],
      "schema": "schemas/link_customer_threads_write.json"
    },
    "whatsapp_inbox._link_known_customer_write": {
      "permission": "whatsapp_inbox.manage_connections",
      "internal": true,
      "transaction": true,
      "sql": [
        "commands/_link_known_customer_write.sql"
      ],
      "schema": "schemas/link_known_customer_write.json"
    },
    "whatsapp_inbox._on_customer_merged": {
      "permission": "whatsapp_inbox.manage_connections",
      "internal": true,
      "transaction": true,
      "sql": [
        "commands/_on_customer_merged.sql"
      ]
    },
    "whatsapp_inbox._quota.set": {
      "permission": "whatsapp_inbox.manage_connections",
      "internal": true,
      "transaction": true,
      "sql": [
        "commands/quota_set.sql"
      ],
      "schema": "schemas/quota_set.json"
    },
    "whatsapp_inbox._sweep_unlinked_threads": {
      "permission": "whatsapp_inbox.manage_connections",
      "internal": true,
      "schema": "schemas/sweep_unlinked_threads.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "sweep_unlinked_threads"
      },
      "reads": [
        {
          "query": "whatsapp_inbox.conversations.unlinked"
        }
      ]
    },
    "whatsapp_inbox._mark_thread_swept": {
      "permission": "whatsapp_inbox.manage_connections",
      "internal": true,
      "transaction": true,
      "sql": [
        "commands/_mark_thread_swept.sql"
      ],
      "schema": "schemas/mark_thread_swept.json"
    }
  },
  "errors": {
    "whatsapp_inbox.conversation_not_found": {},
    "whatsapp_inbox.template_already_here": {},
    "whatsapp_inbox.template_not_found": {}
  },
  "events": {
    "listen": {
      "hub.whatsapp.message_received": {
        "command": "whatsapp_inbox._ingest_inbound_message"
      },
      "whatsapp_inbox.message.received": {
        "command": "whatsapp_inbox._link_known_customer"
      },
      "customer.created": {
        "command": "whatsapp_inbox._link_customer_threads"
      },
      "customer.updated": {
        "command": "whatsapp_inbox._link_customer_threads"
      },
      "customer.merged": {
        "command": "whatsapp_inbox._on_customer_merged"
      },
      "whatsapp_inbox.conversation.link_pending": {
        "command": "whatsapp_inbox._link_known_customer"
      }
    },
    "emits": [
      "whatsapp_inbox.message.received",
      "whatsapp_inbox.conversation.assigned",
      "whatsapp_inbox.template.created",
      "whatsapp_inbox.template.updated",
      "whatsapp_inbox.template.deleted",
      "whatsapp_inbox.conversation.link_pending"
    ]
  },
  "scheduled_tasks": [
    {
      "name": "sweep_unlinked_threads",
      "command": "whatsapp_inbox._sweep_unlinked_threads",
      "cron": "*/15 * * * *",
      "catch_up": "collapse"
    }
  ],
  "ui": {
    "entry": "dist/whatsapp_inbox.esm.js"
  },
  "billing": {
    "tier": "premium",
    "type": "subscription",
    "trial_days": 0,
    "tiers": [
      {
        "slug": "free",
        "name": "Free",
        "price": 0,
        "interval": "month",
        "quota": {
          "billable_messages_per_month": 30
        }
      },
      {
        "slug": "basic",
        "name": "Basic",
        "price": 0,
        "interval": "month",
        "quota": {
          "billable_messages_per_month": 150
        }
      },
      {
        "slug": "pro",
        "name": "Pro",
        "price": 0,
        "interval": "month",
        "quota": {
          "billable_messages_per_month": 500
        }
      },
      {
        "slug": "enterprise",
        "name": "Enterprise",
        "price": 0,
        "interval": "month",
        "quota": {
          "billable_messages_per_month": 800
        }
      }
    ],
    "usage": {
      "query": "whatsapp_inbox.usage.get",
      "metric": "billable_messages_per_month",
      "used": "billable_this_month",
      "limit": "monthly_limit"
    }
  }
}
