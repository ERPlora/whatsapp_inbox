{
  "grants": [
    {
      "kind": "notify",
      "value": "whatsapp"
    },
    {
      "kind": "recipient_query",
      "value": "whatsapp_inbox.conversations.list#contact_phone"
    },
    {
      "kind": "query",
      "value": "customers.by_phone"
    },
    {
      "kind": "query",
      "value": "services.services.list"
    },
    {
      "kind": "query",
      "value": "staff.members.list"
    },
    {
      "kind": "query",
      "value": "staff.schedules.list_for_member"
    },
    {
      "kind": "query",
      "value": "appointments.settings.get"
    },
    {
      "kind": "command",
      "value": "appointments.availability.day_opening"
    },
    {
      "kind": "command",
      "value": "appointments.availability.slots"
    },
    {
      "kind": "command",
      "value": "appointments.availability.check"
    },
    {
      "kind": "command",
      "value": "customers.create"
    },
    {
      "kind": "command",
      "value": "appointments.appointments.create",
      "payload": {
        "booked_online": true
      }
    },
    {
      "kind": "query",
      "value": "appointments.appointments.list_for_customer",
      "payload": {
        "customer_id": "steps.resolve_customer.id"
      }
    },
    {
      "kind": "command",
      "value": "appointments.appointments.cancel",
      "payload": {
        "channel": "customer"
      }
    },
    {
      "kind": "command",
      "value": "appointments.appointments.reschedule",
      "payload": {
        "channel": "customer"
      }
    },
    {
      "kind": "command",
      "value": "whatsapp_inbox.conversations.link_customer"
    },
    {
      "kind": "query",
      "value": "whatsapp_inbox.conversations.last_offer",
      "payload": {
        "wa_contact_id": "input.from"
      }
    },
    {
      "kind": "command",
      "value": "whatsapp_inbox.conversations.remember_offer",
      "payload": {
        "wa_contact_id": "input.from"
      }
    }
  ]
}
