{
  "schema_version": 1,
  "name": "Appointment confirmed → WhatsApp",
  "triggers": [
    {
      "kind": "event",
      "event": "appointments.appointment.confirmed",
      "input": {
        "appointment_id": "event.appointment_id"
      }
    }
  ],
  "steps": [
    {
      "id": "read_appointment",
      "kind": "query",
      "query": "appointments.appointments.get",
      "params": {
        "appointment_id": "input.appointment_id"
      },
      "result": "first",
      "limit": 1
    },
    {
      "id": "has_a_phone",
      "kind": "condition",
      "when": {
        "steps.read_appointment.found": {
          "eq": true
        },
        "steps.read_appointment.customer_phone": {
          "neq": ""
        }
      }
    },
    {
      "id": "reachable_on_whatsapp",
      "kind": "query",
      "query": "whatsapp_inbox.conversations.by_phone",
      "params": {
        "phone": "steps.read_appointment.customer_phone"
      },
      "result": "first",
      "limit": 1
    },
    {
      "id": "phone_is_international",
      "kind": "condition",
      "when": {
        "steps.reachable_on_whatsapp.phone_is_international": {
          "eq": true
        }
      }
    },
    {
      "id": "has_a_thread",
      "kind": "condition",
      "when": {
        "steps.reachable_on_whatsapp.has_thread": {
          "eq": true
        }
      }
    },
    {
      "id": "tell_the_customer",
      "kind": "notify",
      "channel": "whatsapp",
      "to": {
        "query": "whatsapp_inbox.conversations.by_phone",
        "params": {
          "phone": "steps.read_appointment.customer_phone"
        },
        "field": "contact_phone"
      },
      "template": "",
      "vars": {
        "text": "Confirmed! We'll see you on {{steps.read_appointment.start_date_label}} at {{steps.read_appointment.start_time_label}} for your {{steps.read_appointment.service_name}} with {{steps.read_appointment.staff_name}}."
      }
    }
  ]
}
